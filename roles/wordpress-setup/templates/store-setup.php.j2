<?php
/**
 * {{ ansible_managed }}
 * Idempotent WooCommerce store setup, run with `wp eval-file`.
 * Prints "changed=<n>" so Ansible can report changes accurately.
 */
$changed = 0;

// Store settings ------------------------------------------------------------
$options = array(
	'blogname'                          => '{{ wordpress_setup_site_title }}',
	'permalink_structure'               => '/%postname%/',
	'woocommerce_currency'              => '{{ wordpress_setup_store.currency }}',
	'woocommerce_default_country'       => '{{ wordpress_setup_store.country }}',
	'woocommerce_store_city'            => '{{ wordpress_setup_store.city }}',
	'woocommerce_store_address'         => '{{ wordpress_setup_store.address }}',
	'woocommerce_store_postcode'        => '{{ wordpress_setup_store.postcode }}',
	// New stores start in "coming soon" mode, which hides the shop.
	'woocommerce_coming_soon'           => 'no',
	'woocommerce_store_pages_only'      => 'no',
	'woocommerce_onboarding_profile'    => array( 'skipped' => true ),
	'woocommerce_task_list_hidden'      => 'yes',
	'woocommerce_allow_tracking'        => 'no',
	'woocommerce_show_marketplace_suggestions' => 'no',
);
foreach ( $options as $name => $value ) {
	if ( get_option( $name ) !== $value ) {
		update_option( $name, $value );
		$changed++;
	}
}
if ( $changed ) {
	flush_rewrite_rules();
}

// Shop, cart, checkout and account pages --------------------------------------
foreach ( array( 'shop', 'cart', 'checkout', 'myaccount' ) as $page ) {
	if ( wc_get_page_id( $page ) <= 0 || ! get_post( wc_get_page_id( $page ) ) ) {
		WC_Install::create_pages();
		$changed++;
		break;
	}
}

// Cash on delivery, so a test order can be placed end to end -------------------
$cod = get_option( 'woocommerce_cod_settings', array() );
if ( ( $cod['enabled'] ?? 'no' ) !== 'yes' ) {
	$cod['enabled'] = 'yes';
	$cod['title']   = $cod['title'] ?? 'Cash on delivery';
	update_option( 'woocommerce_cod_settings', $cod );
	$changed++;
}

// Sample products (matched by SKU) ---------------------------------------------
$products = json_decode( '{{ wordpress_setup_sample_products | to_json }}', true );
foreach ( $products as $p ) {
	if ( wc_get_product_id_by_sku( $p['sku'] ) ) {
		continue;
	}
	$product = new WC_Product_Simple();
	$product->set_name( $p['name'] );
	$product->set_sku( $p['sku'] );
	$product->set_regular_price( $p['price'] );
	$product->set_description( $p['description'] );
	$product->set_status( 'publish' );
	$product->set_catalog_visibility( 'visible' );
	$product->save();
	$changed++;
}

echo "changed={$changed}\n";
