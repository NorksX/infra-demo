; {{ ansible_managed }}
; Dedicated pool for WordPress. Mode 0640: it holds the Redis password.
[wordpress]
user = www-data
group = www-data
listen = {{ wordpress_setup_fpm_socket }}
listen.owner = www-data
listen.group = www-data
listen.mode = 0660

pm = dynamic
pm.max_children = {{ wordpress_setup_fpm_max_children }}
pm.start_servers = {{ wordpress_setup_fpm_start_servers }}
pm.min_spare_servers = {{ wordpress_setup_fpm_min_spare }}
pm.max_spare_servers = {{ wordpress_setup_fpm_max_spare }}
pm.max_requests = {{ wordpress_setup_fpm_max_requests }}

; PHP sessions are shared by all web nodes through Redis (via HAProxy).
php_admin_value[session.save_handler] = redis
php_admin_value[session.save_path] = "tcp://{{ wordpress_setup_redis_host }}:{{ wordpress_setup_redis_port }}?auth={{ wordpress_setup_redis_password }}&database={{ wordpress_setup_redis_session_db }}"

; Limit PHP to the site and temp directories.
php_admin_value[open_basedir] = {{ wordpress_setup_docroot }}:/tmp:/usr/share/php
php_admin_flag[expose_php] = off
