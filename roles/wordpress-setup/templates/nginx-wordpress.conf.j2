# {{ ansible_managed }}
upstream php_wordpress {
    server unix:{{ wordpress_setup_fpm_socket }};
}

server {
    listen 80 default_server;
    server_name {{ wordpress_setup_server_name }};
    root {{ wordpress_setup_docroot }};
    index index.php;

    # Real client address from HAProxy (needed for logs, WooCommerce, fail2ban).
{% for proxy in wordpress_setup_trusted_proxies %}
    set_real_ip_from {{ proxy }};
{% endfor %}
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    # HAProxy health check: PHP + database, without loading WordPress.
    location = /healthz {
        access_log off;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME {{ wordpress_setup_docroot }}/healthz.php;
        fastcgi_pass php_wordpress;
    }

    location / {
        try_files $uri $uri/ /index.php?$args;
    }

    # Never execute PHP from the shared uploads directory.
    location ~* ^/wp-content/uploads/.*\.php$ {
        deny all;
    }

    location ~ /\.(?!well-known) { deny all; }
    location ~* ^/(wp-config\.php|readme\.html|license\.txt|xmlrpc\.php)$ { deny all; }

    location ~ \.php$ {
        try_files $uri =404;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param HTTPS $wordpress_https;
        fastcgi_read_timeout 60s;
        fastcgi_pass php_wordpress;
    }

    location ~* \.(css|js|png|jpe?g|gif|svg|webp|ico|woff2?)$ {
        expires 30d;
        access_log off;
        try_files $uri /index.php?$args;
    }
}

# HAProxy terminates TLS; tell PHP when the original request was HTTPS.
map $http_x_forwarded_proto $wordpress_https {
    default "";
    https   on;
}
