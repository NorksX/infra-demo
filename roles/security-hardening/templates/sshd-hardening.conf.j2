# {{ ansible_managed }}
Port {{ security_hardening_ssh_port }}

PermitRootLogin {{ security_hardening_ssh_permit_root_login }}
PasswordAuthentication {{ 'yes' if security_hardening_ssh_password_authentication else 'no' }}
KbdInteractiveAuthentication no
PubkeyAuthentication yes
PermitEmptyPasswords no
AllowUsers {{ security_hardening_ssh_allow_users | join(' ') }}

MaxAuthTries {{ security_hardening_ssh_max_auth_tries }}
LoginGraceTime {{ security_hardening_ssh_login_grace_time }}
ClientAliveInterval {{ security_hardening_ssh_client_alive_interval }}
ClientAliveCountMax {{ security_hardening_ssh_client_alive_count_max }}

X11Forwarding no
AllowAgentForwarding no
PermitTunnel no

KexAlgorithms {{ security_hardening_ssh_kex | join(',') }}
Ciphers {{ security_hardening_ssh_ciphers | join(',') }}
MACs {{ security_hardening_ssh_macs | join(',') }}

LogLevel VERBOSE
